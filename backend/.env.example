# Contoh — copy ke backend/.env lalu isi key asli. Jangan commit .env.
# Dapatkan Gemini key di https://aistudio.google.com/app/apikey
GEMINI_API_KEY=ISI_API_KEY_ANDA
GEMINI_MODEL=gemini-2.0-flash
# Opsional — untuk web search. Dapatkan di https://app.tavily.com
TAVILY_API_KEY=ISI_TAVILY_API_KEY_ANDA

# --- Agent (Google ADK) ---
# Semua di bawah opsional, ada nilai defaultnya.
# ADK_MAX_LLM_CALLS batas jumlah panggilan LLM per turn chat (default 8).
# Nilai <= 0 berarti tanpa batas — hindari, bisa looping terus.
ADK_MAX_LLM_CALLS=8
# Suhu model, makin rendah makin konsisten (default 0.3).
AGENT_TEMPERATURE=0.3
# Batas durasi satu turn chat dalam detik (default 120).
AGENT_TURN_TIMEOUT=120
# Jumlah hasil per pencarian web (default 5).
TAVILY_MAX_RESULTS=5

# --- RAG materi (upload lokal + ingest) ---
# Model embedding untuk isi vector store lokal (default gemini-embedding-001).
GEMINI_EMBED_MODEL=gemini-embedding-001
# Direktori byte file upload, di bawah ./data/ (ikut .gitignore).
STORAGE_DIR=./data/materials
# Ukuran chunk karakter + overlap saat split (default 800/100).
# RAG_CHUNK_SIZE=800
# RAG_CHUNK_OVERLAP=100
# Jumlah chunks disuntik ke prompt tutor (default 5).
# RAG_TOP_K=5

# --- LMS Bebas UMPO (scraper Playwright, opsional) ---
# Diisi kalau mau pakai tool lms_list_courses / lms_list_activities /
# lms_get_assignment_detail. Butuh `pip install playwright beautifulsoup4`
# lalu `playwright install chromium` sekali.
LMS_BASE_URL=https://bebas.umpo.ac.id
LMS_USERNAME=ISI_NIM_ANDA
LMS_PASSWORD=ISI_PASSWORD_ANDA

# --- Seed demo (data contoh matkul) ---
# false = jangan isi data contoh otomatis (database fresh/nol permanen).
SEED_DEMO_DATA=false

# --- Database (SQLite riwayat chat) ---
# Tabel aplikasi (list/hapus riwayat). Path relatif dari root repo.
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# State internal ADK (konteks agent persisten). Dipisah agar tidak lock.
# Wajib pakai driver async sqlite+aiosqlite:// (kebutuhan ADK 2.10).
ADK_DATABASE_URL=sqlite+aiosqlite:///./data/adk_sessions.db
